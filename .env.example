# BED4BOOK API — example configuration. Copy to .env and fill in real values.
# Never commit real secrets.
PORT=3000
DATABASE_URL=postgres://bed4book:change-me@localhost:5432/bed4book
DATABASE_SSL=false
DB_POOL_MAX=10
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Reverse-proxy trust for client IPs (login throttling). Required when NODE_ENV=production.
#   false            → no proxy; X-Forwarded-For is ignored (local development, tests)
#   1                → one reverse proxy in front of the app (e.g. Railway edge); verify with the proxy's docs/logs
#   10.0.0.0/8,...   → explicit trusted proxy addresses/subnets
# "true" is refused: it would let any client choose its own IP.
NODE_ENV=development
TRUST_PROXY=false

