{
  "name": "bed4book-platform",
  "version": "1.0.0",
  "private": true,
  "description": "BED4BOOK Hotel Wholesale Platform server foundation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json && node -e \"const fs=require('fs');fs.cpSync('server/assets','dist-server/server/assets',{recursive:true});fs.cpSync('server/migrations','dist-server/server/migrations',{recursive:true})\"",
    "start:server": "node dist-server/server/app.js",
    "dev:server": "tsx watch server/app.ts",
    "test:server": "tsx --test --test-concurrency=1 tests/server/*.test.ts",
    "admin:create": "tsx server/cli/create-admin.ts",
    "perf:smoke": "tsx infra/scripts/perf-smoke.ts",
    "db:migrate": "tsx server/migrate.ts",
    "db:migrate:compiled": "node dist-server/server/migrate.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pdfkit": "0.17.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
